{
  "name": "scene-to-gltf",
  "version": "0.1.0",
  "description": "Convert AssetRipper Unity scene export into glTF 2.0 / GLB",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "bin": {
    "scene-to-gltf": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "npx esbuild src/cli/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:memory": "vitest run test/convert/memory_benchmark.test.ts",
    "test:watch": "vitest",
    "validate": "node dist/scripts/validate_gltf.js",
    "benchmark:memory": "node dist/scripts/verify_memory.js"
  },
  "keywords": [
    "unity",
    "gltf",
    "glb",
    "assetripper",
    "3d",
    "converter"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
